{
	"name": "Stewardbook",
	"short_name": "Stewardbook",
	"description": "Grievance tracker for union stewards: contract deadlines, case timelines and clean handoffs.",
	"id": "/",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"orientation": "any",
	"background_color": "#f6f4ef",
	"theme_color": "#1d2b4a",
	"categories": ["productivity", "business"],
	"icons": [
		{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
		{ "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
		{ "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
		{ "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
	],
	"shortcuts": [
		{ "name": "New case", "url": "/cases/new", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
		{ "name": "Open cases", "url": "/cases", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
	]
}
