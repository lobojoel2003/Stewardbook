# Postgres connection string (required)
DATABASE_URL="postgres://stewardbook:stewardbook@localhost:5432/stewardbook"

# Apply database migrations automatically on start (default: true)
# MIGRATE_ON_START=true

# Timezone used for "today" until the local picks its own in setup
# DEFAULT_TIMEZONE=America/New_York

# Largest attachment a steward can upload, in MB (default: 15)
# MAX_UPLOAD_MB=15

# Source link shown in Settings → About (AGPL-3.0 §13). Point it at your fork if you modify Stewardbook.
# SOURCE_CODE_URL=https://github.com/lobojoel2003/Stewardbook

# Optional: a local, OpenAI-compatible LLM endpoint to draft contract deadlines.
# Ollama:    LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1:8b
# llama.cpp: LLM_BASE_URL=http://localhost:8080/v1
# LLM_BASE_URL=
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=120

# Production only: the public URL of the app (adapter-node needs it for form CSRF checks behind a proxy)
# ORIGIN=https://stewardbook.example.org
